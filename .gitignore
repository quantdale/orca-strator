# Dependencies / build output
node_modules/
dist/
build/
out/
coverage/
.vite/
*.tsbuildinfo

# Python cache
__pycache__/
*.pyc

# Test / browser automation output
playwright-report/
test-results/
blob-report/
.playwright/
.playwright-mcp/
playwright/.auth/

# Local Orca runtime data (never commit browser/session/database state).
# These are ANCHORED to the repository root on purpose: generic directory names
# such as runtime/ or logs/ must never silently swallow nested production
# source directories anywhere in the monorepo. The regression guard at
# scripts/ci/check-source-integrity.mjs fails when any tracked relative import
# resolves to a missing, ignored, or untracked module.
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db-journal
/logs/
/runtime/
/browser-profile/
/.orca-local/

# Change 025 packaging output (staged runtime + release artifacts)
apps/desktop/resources/
apps/desktop/release/

# Local environment / credentials
.env
.env.*
!.env.example
*.pem
*.key

# Logs / temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*.zip

# IDE / OS noise
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
Desktop.ini

# Note: managed repositories intentionally commit .orca/ coordination artifacts.
