{
  "name": "@orca/desktop",
  "version": "0.1.0",
  "description": "Orca-Strator Windows desktop shell",
  "author": "Orca-Strator contributors",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "npm run build --workspace=@orca/shared && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace=@orca/shared && tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && electron dist/main.js",
    "start": "electron dist/main.js",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orca/shared": "*"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "typescript": "^5.7.3",
    "@types/node": "^24.0.0"
  }
}
