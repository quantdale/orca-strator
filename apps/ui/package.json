  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^8.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.2.0"
