{
  "name": "@orca/controller",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/index.js",
    "start": "node dist/index.js",
    "build": "npm run build --workspace=@orca/shared && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace=@orca/shared && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@orca/shared": "*",
    "fastify": "^5.2.1",
    "@fastify/websocket": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^24.0.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.14"
  }
}
