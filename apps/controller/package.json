{
  "name": "@orca/controller",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "npm run build && node --watch dist/index.js",
    "start": "node dist/index.js",
    "build": "npm run build --workspace=@orca/shared && tsc -p tsconfig.json",
    "typecheck": "npm run build --workspace=@orca/shared && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"**/real-*.test.ts\"",
    "test:real": "vitest run test/real-runtime-qualification.test.ts test/real-runtime-controls.test.ts test/real-runtime-buildapp.test.ts test/real-operational-intelligence.test.ts test/real-worktree-isolation.test.ts --no-file-parallelism",
    "browser:install": "playwright install chromium",
    "playwright:status": "node -e \"import('./dist/browser/provisioning.js').then(m=>m.getChromiumStatus().then(s=>console.log(JSON.stringify(s,null,2)))).catch(e=>console.error(e.message))\"",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.0.2",
    "@orca/shared": "*",
    "fastify": "^5.2.1",
    "playwright-core": "1.62.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "playwright": "1.62.1",
    "typescript": "^5.7.3",
    "ws": "^8.18.0"
  }
}
