{
  "name": "orca-strator",
  "version": "0.1.0",
  "private": true,
  "description": "Windows-first autonomous multi-repository development orchestrator",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:controller": "npm run dev --workspace=@orca/controller",
    "dev:ui": "npm run dev --workspace=@orca/ui",
    "dev:desktop": "npm run dev --workspace=@orca/desktop",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@orca/shared",
    "build:ui": "npm run build --workspace=@orca/ui",
    "build:controller": "npm run build --workspace=@orca/controller",
    "build:desktop": "npm run build --workspace=@orca/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
